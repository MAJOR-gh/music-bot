# Токен бота из Discord Developer Portal (ОБЯЗАТЕЛЬНО)
DISCORD_TOKEN=your_bot_token_here

# ID твоего сервера для мгновенной синхронизации команд (опционально).
# Если оставить пустым — команды синхронизируются глобально (до ~1 часа).
GUILD_ID=

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Через сколько секунд бездействия бот сам отключается (по умолчанию 300 = 5 минут)
IDLE_TIMEOUT=300

# Где по умолчанию искать текст из /play: youtube | ytmusic | spotify | lastfm
# (в самой команде источник можно выбрать параметром source).
DEFAULT_SEARCH=youtube

# Поиск по Spotify (необязательно; ссылки на Spotify работают и без ключей).
# Ключи бесплатно: developer.spotify.com → Dashboard → Create app.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Поиск по Last.fm (необязательно). Ключ бесплатно: last.fm/api/account/create
# С ключом и DEFAULT_SEARCH=lastfm подсказки в /play тоже идут из Last.fm.
LASTFM_API_KEY=

# Запасной SoundCloud, если YouTube не отдал трек (по умолчанию выключен).
SOUNDCLOUD_FALLBACK=0

# Сколько треков максимум брать из плейлиста/альбома Spotify.
MAX_PLAYLIST_TRACKS=100

# Автообновление yt-dlp раз в 12 часов (1 — вкл, 0 — выкл). Старый yt-dlp
# ловит 403 от YouTube — звук рвётся или пропадает.
YTDLP_AUTO_UPDATE=1

# Качать звук через yt-dlp, минуя прямые ссылки googlevideo. Ставь 1 на
# хостинге с датацентровым IP и при игре через VPN/туннель.
FORCE_PIPE=

# Папка с ffmpeg.exe / ffprobe.exe, если их нет в системном PATH.
FFMPEG_DIR=

# Путь к cookies.txt YouTube-аккаунта (Netscape), если YouTube просит
# «Sign in to confirm you're not a bot». По умолчанию — cookies.txt рядом с ботом.
YTDLP_COOKIES=

# Или брать куки прямо из браузера на этом ПК: firefox | chrome | edge …
# (только при запуске на своём компьютере; на хостинге нужен cookies.txt).
YTDLP_COOKIES_FROM_BROWSER=

# ── Тонкая настройка (обычно не нужна) ──
# Клиенты YouTube для всех запросов. Пусто — как yt-dlp; при отказах YouTube бот
# сам перебирает: по умолчанию → tv_samsung → default,web_embedded → web_music.
#YTDLP_EXTRACTOR_ARGS=youtube:player_client=tv
# Ночные сборки yt-dlp (1) или только stable (0). Фиксы под YouTube сначала в nightly.
#YTDLP_NIGHTLY=1
# Лимит памяти deno (JS-challenge YouTube). На тарифах 512 МБ меньше 128 не ставь.
#DENO_V8_FLAGS=--max-old-space-size=144
# Битрейт перекодирования, кбит/с (Opus с YouTube идёт без перекодирования).
#AUDIO_BITRATE=256
# PO Token (bgutil-pot, только Linux x86_64). Держит ~70 МБ памяти.
#POT_ENABLED=0
